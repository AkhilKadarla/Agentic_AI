{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushFinSightImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/finsight"
    },
    {
      "Sid": "FindRuntime",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListAgentRuntimes",
        "bedrock-agentcore:ListAgentRuntimeVersions",
        "bedrock-agentcore:ListAgentRuntimeEndpoints"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateRuntimeOnlyWithLogin",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:CreateAgentRuntime",
      "Resource": "*",
      "Condition": { "StringEquals": { "bedrock-agentcore:RuntimeAuthorizerType": "CUSTOM_JWT" } }
    },
    {
      "Sid": "UpdateRuntimeOnlyWithLogin",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:UpdateAgentRuntime",
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/finsight-*",
      "Condition": { "StringEquals": { "bedrock-agentcore:RuntimeAuthorizerType": "CUSTOM_JWT" } }
    },
    {
      "Sid": "CreateDefaultEndpoint",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:CreateAgentRuntimeEndpoint",
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/*"
    },
    {
      "Sid": "UpdateFinSightEndpoints",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:UpdateAgentRuntimeEndpoint",
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/finsight-*",
        "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/finsight-*/runtime-endpoint/*"
      ]
    },
    {
      "Sid": "ReadRuntime",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:GetAgentRuntimeEndpoint",
        "bedrock-agentcore:TagResource"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/finsight-*",
        "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/finsight-*/runtime-endpoint/*"
      ]
    },
    {
      "Sid": "RuntimeWorkloadIdentity",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateWorkloadIdentity",
        "bedrock-agentcore:GetWorkloadIdentity",
        "bedrock-agentcore:UpdateWorkloadIdentity"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:workload-identity-directory/default/workload-identity/finsight*"
      ]
    },
    {
      "Sid": "HandOverOnlyTheRuntimeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/finsight-agentcore-runtime",
      "Condition": { "StringEquals": { "iam:PassedToService": "bedrock-agentcore.amazonaws.com" } }
    }
  ]
}
