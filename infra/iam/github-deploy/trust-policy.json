        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:AkhilKadarla@176090525/Agentic_AI@1385258343:environment:production"
        }
      }
    }
  ]
}
