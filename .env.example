# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# cp .env.example .env

# Anthropic API key (needed from Phase 3) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# SEC EDGAR requires a User-Agent with your name + email for its free API
SEC_USER_AGENT="Your Name your.email@example.com"
