# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# cp .env.example .env

# Anthropic API key (needed from Phase 3) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# SEC EDGAR requires a User-Agent with your name + email for its free API
SEC_USER_AGENT="Your Name your.email@example.com"

# Which service runs Claude: "anthropic" (default) or "bedrock" (Amazon Bedrock)
FINSIGHT_PROVIDER=anthropic

# --- Bedrock only ---
# AWS CLI profile set up with `aws configure sso` (short-lived SSO credentials, no keys)
AWS_PROFILE=finsight
AWS_REGION=us-east-1
# "us." = US-only cross-region inference profile (data stays in US regions)
FINSIGHT_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
